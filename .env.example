# chomikuj.pl account (start with a separate test account)
CHOMIKUJ_LOGIN=
CHOMIKUJ_PASSWORD=

# Where the page is reachable: your homelab's LAN IP and port
BIND_ADDR=127.0.0.1
PORT=8080
# If you open the page by name (e.g. http://homelab.lan:8080) list the names here, comma-separated.
# Opening it by IP address always works.
ALLOWED_HOSTS=

# Owner of downloaded files (output of `id -u` and `id -g`)
PUID=1000
PGID=1000

# Pacing — keep it human (seconds)
MIN_JOB_GAP_SECONDS=20
HUMAN_PAUSE_MIN=1.0
HUMAN_PAUSE_MAX=4.0

# Set to false only for a one-off manual login on a machine with a display (see README)
HEADLESS=true

# Optional. Makes the printed admin link complete, e.g. http://192.168.1.10:8080
PUBLIC_URL=
